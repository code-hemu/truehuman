{
  "name": "truehuman",
  "version": "0.0.6",
  "description": "Human verification, and anti-bot detection library for web applications.",
  "homepage": "https://github.com/code-hemu/truehuman#readme",
  "bugs": {
    "url": "https://github.com/code-hemu/truehuman/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-hemu/truehuman.git"
  },
  "license": "GPL-3.0",
  "author": "Hemanta Gayen",
  "type": "module",
  "keywords": [
    "truehuman",
    "bot-detection",
    "browser-fingerprinting",
    "anti-bot",
    "fingerprint",
    "device-fingerprint",
    "browser-integrity",
    "headless-detection",
    "webdriver-detection",
    "fraud-detection",
    "human-verification",
    "captcha-alternative",
    "security"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/truehuman.cjs.js",
  "module": "./dist/truehuman.esm.js",
  "browser": "./dist/truehuman.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/truehuman.min.js",
  "jsdelivr": "./dist/truehuman.min.js",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/truehuman.esm.js",
      "require": "./dist/truehuman.cjs.js",
      "default": "./dist/truehuman.esm.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "guchho clean",
    "test": "tsc -p tsconfig.test.json && node --test \"tests/**/*.test.mjs\"",
    "dev": "cd playground && guchho dev --open",
    "build": "guchho build",
    "playground:build": "cd playground && guchho build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@guchho/banner": "^0.1.4",
    "@guchho/dts": "^0.2.0",
    "@typescript/typescript6": "^6.0.2",
    "guchho": "^1.0.8",
    "typescript": "^7.0.2"
  }
}
